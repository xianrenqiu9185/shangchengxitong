# ============================================================
# 邻里鲜生 · 部署环境变量模板
# 用法：cp deploy/.env.example deploy/.env，按需修改后启动
# 注意：deploy/.env 已被 .gitignore 忽略，禁止提交真实口令
# ============================================================

# 后端运行 profile（prod 表示按环境变量注入，不使用本地明文配置）
SPRING_PROFILES_ACTIVE=prod

# 对外端口
API_PORT=8080

# MySQL
MYSQL_DATABASE=linli_fresh
MYSQL_ROOT_PASSWORD=root123456
DB_USERNAME=root
DB_PASSWORD=root123456

# Redis（无口令时留空）
REDIS_PASSWORD=

# 镜像标签，回滚时切回上一个版本号
IMAGE_TAG=local
