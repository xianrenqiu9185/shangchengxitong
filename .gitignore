# ============================================================
# 邻里鲜生 · Git 忽略规则
# ============================================================

# ---------- OS / IDE ----------
.DS_Store
Thumbs.db
.idea/
*.iml
.vscode/
*.swp
*.swo
*~

# ---------- Java / Maven ----------
target/
build/
out/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*
# 保留 Maven Wrapper
!.mvn/wrapper/maven-wrapper.jar

# ---------- Node / 前端 ----------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# ---------- 测试与覆盖率 ----------
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/

# ---------- 日志 / 临时文件 ----------
/logs/
*.log
tmp/
temp/
*.tmp
*.bak
~$*.docx
~$*.xlsx

# ---------- 环境与密钥 ----------
.env
.env.local
.env.*.local
*.secret
*.pem
*.key
*.p12
*.jks
# 说明：.env.development / .env.staging / .env.production 仅含非敏感配置，允许提交

# ---------- 运行时数据（仅仓库根目录） ----------
/data/
/mysql-data/
/redis-data/
/uploads/

# ---------- 历史 / 过程稿（仅本地保留，不提交） ----------
docs/架构设计说明书.md
docs/设计文档-原始.docx
docs/设计文档(1).docx
